# Salin file ini menjadi ".env" lalu sesuaikan.
# File .env tidak pernah ikut dalam zip/repo (berisi kredensial).

# --- Mode 1: lokal / VPS / Railway (SQLite file) ---
DATABASE_URL="file:./db/custom.db"

# --- Mode 2: Turso di Vercel / serverless ---
# DATABASE_URL="libsql://nama-db-xxx.turso.io"
# DATABASE_AUTH_TOKEN="eyJ...."

# Opsional — fitur Asisten AI (tanpa ini aplikasi tetap jalan, parser lokal aktif)
# ZAI_API_KEY="..."
